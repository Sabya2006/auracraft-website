# Server Port & Environment
PORT=5000
NODE_ENV=production

# Supabase Cloud Database Credentials (Server-Side Only)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY

# MongoDB Atlas Connection URI (Optional Server-Side Only)
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster.mongodb.net/auracraft_db?retryWrites=true&w=majority

# JWT Authentication Secret (CRITICAL: MUST BE A RANDOM HIGH-ENTROPY SECRET STRING)
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS

# Corporate Staff Credentials
ADMIN_EMAIL=admin@auracraft.com
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# Allowed Frontend Origins for CORS Security
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN.vercel.app
