# =================================================================
# AuraCraft Web Agency API Server Environment Variables Template
# =================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL SECRETS.
# DO NOT COMMIT THE REAL .env FILE TO GIT!
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://auracraft-website.vercel.app

# JWT Secret Key (Required for signing staff authentication tokens)
# Generate a strong 32+ character random string: openssl rand -base64 32
JWT_SECRET=your_jwt_signing_secret_here

# Admin Account Overrides (Optional)
ADMIN_ORACRAFT_ID=OC-DIR-9001
ADMIN_PASSWORD=your_admin_password_here

# Razorpay Payment Gateway (Server-Side Secret & Live Key ID)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Cloud Database (Optional for cloud DB persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MongoDB Connection URI (Optional)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/auracraft?retryWrites=true&w=majority
