# =================================================================
# AuraCraft Frontend Client Environment Variables Template
# =================================================================
# COPY THIS FILE TO .env AND FILL IN PUBLIC-SAFE VALUES ONLY.
# DO NOT ADD PRIVATE SECRETS OR SECRET KEYS WITH VITE_ PREFIX!
# =================================================================

# Public API Base URL
VITE_API_BASE_URL=http://localhost:5000

# Public Razorpay Key ID (Public-safe for Razorpay Checkout JS modal)
VITE_RAZORPAY_KEY_ID=rzp_test_public_key_id_here
